# Homeground — all optional; every value below is the built-in default.
# No API keys are required: Nominatim, Overpass and OpenTopoData are all keyless.
# Load with:  node --env-file=.env  (or `npm run dev` with the defaults)

PORT=8787

# Identify yourself to OSM services. Put a real contact URL/email here before
# running this anywhere but localhost — it is an OSM usage-policy requirement.
HG_USER_AGENT=Homeground/0.1 (playable real-world street levels; https://github.com/homeground)

HG_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
HG_OVERPASS_URL=https://overpass-api.de/api/interpreter
HG_ELEVATION_URL=https://api.opentopodata.org/v1

# Elevation datasets, tried in order. ned10m = USGS 3DEP 10m (US only, float
# precision). srtm90m = NASA SRTM, near-global. First one with >=60% coverage wins.
HG_ELEVATION_DATASETS=ned10m,srtm90m

# Half-width of the world box in meters, and elevation samples per side.
# GRID=33 -> 1089 samples -> 11 upstream calls -> ~13s cold, then cached forever.
HG_RADIUS_METERS=1000
HG_GRID=33
